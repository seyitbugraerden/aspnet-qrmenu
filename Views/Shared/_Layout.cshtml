<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#203c32" />
    <title>@ViewData["Title"] · Sofra</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">İçeriğe geç</a>
    <header class="site-header">
        <nav class="shell header-inner" aria-label="Ana gezinme">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Sofra ana sayfa"><span class="brand-symbol" aria-hidden="true">s.</span><span>sofra<span class="brand-caption">İYİ LEZZET, GÜZEL ANLAR</span></span></a>
            <a class="menu-link" asp-controller="Home" asp-action="Index">Menüyü keşfet <span aria-hidden="true">↗</span></a>
            <span class="header-note"><span class="status-dot"></span> Sofranıza hoş geldiniz</span>
        </nav>
    </header>
    <main id="main-content" class="shell" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer shell">
        <a class="footer-brand" asp-controller="Home" asp-action="Index">sofra.</a>
        <p>Güzel bir sofrada, güzel anılar birikir.</p>
        <span>Afiyet olsun <span aria-hidden="true">✳</span></span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
