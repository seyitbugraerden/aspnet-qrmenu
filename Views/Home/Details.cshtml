@model aspnet_qrmenu.Models.CategoryDetailDto

@{
    ViewData["Title"] = Model.CategoryName;
}

<a asp-controller="Home" asp-action="Index">← Kategoriler</a>

<h1 class="my-4">@Model.CategoryName</h1>

<div class="row g-3">
    @foreach (var product in Model.Products)
    {
        <div class="col-6 col-md-4">
            <div class="card h-100">
                <img src="@product.Image" alt="@product.ProductName" class="card-img-top"
                     style="height: 180px; object-fit: cover;" />

                <div class="card-body">
                    <h2 class="h5">@product.ProductName</h2>
                    <p class="mb-0">
                        @product.Price.ToString("N2") ₺
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Products.Any())
{
    <p>Bu kategoride henüz ürün bulunmuyor.</p>
}